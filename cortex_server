# Purpose: Run the source-checkout Cortex static server lifecycle.
# Usage: ./cortex_server --start | --stop | --status [--help]
import os
import shutil
import subprocess
import sys


def main():
    override = os.environ.pop('CORTEX_PYTHON', None)
    if override is not None or sys.version_info < (3, 11):
        candidates = [override] if override is not None else ['python3.14', 'python3.13', 'python3.12', 'python3.11']
        for candidate in candidates:
            executable = shutil.which(candidate)
            if executable and subprocess.run(
                [executable, '-c', 'import sys; sys.exit(sys.version_info < (3,11))'],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
            ).returncode == 0:
                os.execv(executable, [executable, os.path.abspath(__file__), *sys.argv[1:]])
        print('Cortex requires Python 3.11+. Set CORTEX_PYTHON to a supported interpreter.', file=sys.stderr)
        return 2
    from brain_bridge.cortex_server import main as lifecycle
    return lifecycle()


if __name__ == '__main__':
    raise SystemExit(main())
